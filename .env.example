# --- Database ---
# Owner connection: used ONLY for migrations (owns tables).
DATABASE_OWNER_URL=postgres://saas_owner:saas_owner@localhost:5432/saas_rsa
# API connection as saas_app (subject to RLS). The worker uses DATABASE_URL too,
# but set to the saas_worker role (outbox functions only):
DATABASE_URL=postgres://saas_app:saas_app@localhost:5432/saas_rsa
# Worker tests and local worker runs:
DATABASE_WORKER_URL=postgres://saas_worker:saas_worker@localhost:5432/saas_rsa
# Passwords pnpm db:migrate sets on the two login roles:
APP_DB_PASSWORD=saas_app
WORKER_DB_PASSWORD=saas_worker

# --- Auth0 (API) ---
# Production: your Auth0 tenant. Leave empty locally to use the dev secret below.
AUTH_JWKS_URL=            # https://<tenant>.<region>.auth0.com/.well-known/jwks.json
AUTH_ISSUER=              # https://<tenant>.<region>.auth0.com/   (keep the trailing slash)
AUTH_AUDIENCE=saas-rsa-api   # Auth0 API identifier, e.g. https://api.saas-rsa.app
AUTH_CLAIM_NAMESPACE=https://saas-rsa.app/
# Shared with the Auth0 Post-Login Action (infra/auth0/post-login-action.js), 32+ characters:
AUTH_ACTION_SECRET=
# Local development only (HS256 test tokens):
AUTH_DEV_SECRET=change-me-local-only-at-least-32-characters

# --- API ---
# Guest ordering app; table QR codes point at <url>/t/<token>
GUEST_APP_URL=https://order.saas-rsa.app
# Extra browser origins allowed to call the API (the guest app origin is always allowed)
CORS_ORIGINS=http://localhost:5173
PORT=3000
LOG_LEVEL=info

# --- Twilio (worker) ---
# Without these the worker logs messages instead of sending them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional, recommended: an API key instead of the account auth token
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# SMS: a sender number (E.164) or a Messaging Service SID
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp: approved sender and one approved Content template per message type
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SIDS={"schedule_published":"HX..."}
POLL_INTERVAL_MS=2000
