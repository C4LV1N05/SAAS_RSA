# --- Database ---
# Owner connection: used ONLY for migrations (owns tables, may bypass RLS).
DATABASE_OWNER_URL=postgres://saas_owner:saas_owner@localhost:5432/saas_rsa
# App connection: the API and worker connect as saas_app, which is subject to RLS.
DATABASE_URL=postgres://saas_app:saas_app@localhost:5432/saas_rsa

# --- Redis (BullMQ notification queue) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Production: point at your identity provider's JWKS (Supabase, Clerk, Auth0, Cognito).
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=saas-rsa-api
# Local development only: HS256 shared secret used when AUTH_JWKS_URL is empty.
AUTH_DEV_SECRET=change-me-local-only-at-least-32-characters

# --- API ---
PORT=3000
LOG_LEVEL=info

# --- Notifications (worker) ---
# Providers are optional; without credentials the console provider logs messages.
WHATSAPP_PROVIDER_URL=
WHATSAPP_API_KEY=
SMS_PROVIDER_URL=
SMS_API_KEY=
